# =====================================================================
# TMT-A Spatial Memory Experiment Webapp Configuration Template
# =====================================================================

SERVER_HOST=0.0.0.0
SERVER_PORT=5000
DEBUG=False

# Number of targets in each test (e.g. 6 targets)
TARGET_COUNT=6

# Range bounds (e.g. 10 to 99)
TARGET_RANGE_MIN=10
TARGET_RANGE_MAX=99

# Randomize start target on each run (e.g. 21..26, 54..59)
RANDOMIZE_RANGE_EACH_RUN=true
FIXED_START_TARGET=21

# Default Mode (1 to 4)
DEFAULT_MODE=1
ALLOW_MODE_SELECTION=true

# Storage & Privacy
RESULTS_DIR=results
HASH_SALT=tmta_spatial_memory_salt_2026

