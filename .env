# =====================================================================
# TMT-A Spatial Memory Experiment Webapp Configuration
# =====================================================================

# Server Networking
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
DEBUG=False

# Target Range & Count Settings
# Number of sequential targets to test (e.g., 6)
TARGET_COUNT=6

# Allowable numerical range (e.g., 10 to 99)
TARGET_RANGE_MIN=10
TARGET_RANGE_MAX=99

# If true, a new random start target in [MIN, MAX - COUNT + 1] is chosen on each run
# e.g., if TARGET_COUNT=6 and MIN=10, MAX=99 -> 21..26, 54..59, etc.
RANDOMIZE_RANGE_EACH_RUN=true

# Fixed start target (used only if RANDOMIZE_RANGE_EACH_RUN=false)
FIXED_START_TARGET=21

# Default Experimental Mode (1: Static+Lit, 2: Static+Unlit, 3: Shuffled+Lit, 4: Fully Shuffled+Unlit)
DEFAULT_MODE=1

# Allow participant to choose/switch modes (true / false)
ALLOW_MODE_SELECTION=true

# Results Storage Directory (relative to spatial_memory_test/ or absolute)
RESULTS_DIR=results

# Anonymization Salt (used for hashing participant names with SHA-256)
HASH_SALT=tmta_spatial_memory_salt_2026

